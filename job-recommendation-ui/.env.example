# Hosted Spring Boot API on Render (no trailing slash).
VITE_BACKEND_URL=<render-url>

# Local Vite proxy forwards /api to VITE_BACKEND_URL (see vite.config.ts).
# Production builds should set this to ${VITE_BACKEND_URL}/api
VITE_API_BASE_URL=${VITE_BACKEND_URL}/api

# Set to false once the Spring Boot API is running.
VITE_USE_MOCK=false
